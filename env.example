# Base settings
SECRET_KEY=change-me
DEBUG=1

# Optional host and media paths
RENDER_EXTERNAL_HOSTNAME=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
MEDIA_ROOT=media
SENTRY_DSN=

# Backup scheduling
# Leave blank to use Django TIME_ZONE. Set this explicitly in production when the
# scheduled backup window should follow an operator/business timezone.
# Example: Europe/Madrid
BACKUP_SCHEDULING_TIMEZONE=

# Database (pick one)
DB_PATH=db/db.sqlite3
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# MCP server (placeholder values only; do not commit real tokens)
INVOICES_MCP_API_BASE_URL=http://web:8000/api/
INVOICES_MCP_API_TOKEN=replace-with-dedicated-invoices-api-token
INVOICES_MCP_OAUTH_ISSUER_URL=https://invoices.example.com
INVOICES_MCP_OAUTH_RESOURCE_URL=https://invoices.example.com/mcp/
INVOICES_MCP_OAUTH_INTROSPECTION_URL=https://invoices.example.com/oauth/introspect/
INVOICES_MCP_SCOPE_READ=invoices:mcp:read
INVOICES_MCP_SCOPE_DRAFT_WRITE=invoices:mcp:draft:write
INVOICES_MCP_SCOPE_FINALIZE=invoices:mcp:finalize
INVOICES_MCP_SCOPE_ARTIFACT_READ=invoices:mcp:artifact:read
INVOICES_MCP_HOST=127.0.0.1
INVOICES_MCP_PORT=8765
INVOICES_MCP_ENDPOINT_PATH=/mcp/
INVOICES_MCP_PUBLIC_URL=https://invoices.example.com/mcp/
INVOICES_MCP_TIMEOUT_SECONDS=10
INVOICES_MCP_MAX_ARTIFACT_BYTES=5242880

# In-app OAuth authorization server for remote MCP clients
MCP_OAUTH_ISSUER_URL=https://invoices.example.com
MCP_OAUTH_RESOURCE_URL=https://invoices.example.com/mcp/
MCP_OAUTH_ACCESS_TOKEN_EXPIRE_SECONDS=3600
MCP_OAUTH_CIMD_ENABLED=1
MCP_OAUTH_CIMD_TIMEOUT_SECONDS=3
MCP_OAUTH_CIMD_MAX_BYTES=32768
MCP_OAUTH_CIMD_CACHE_SECONDS=3600
# Optional: require this shared secret for MCP token introspection.
MCP_OAUTH_INTROSPECTION_TOKEN=

# Probe-only values for CI/deploy verification; leave blank in normal production.
INVOICES_MCP_AUTH_TEST_TOKENS=
INVOICES_MCP_WRONG_AUDIENCE_TEST_TOKEN=
